@import "colors.rasi"

configuration {
    show-icons: false;
}

* {
    font: "JetBrainsMono 12";
}

window {
    width: 300px;
    border: 0px;
    border-radius: 12px;
    background-color: @background;
    padding: 0px;
}

mainbox {
    spacing: 10px;
    padding: 20px;
    background-color: transparent;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    spacing: 10px;
    border-radius: 20px;
    background-color: @background;
    text-color: @foreground;
    children: [ "textbox-prompt-colon", "prompt" ];
}

textbox-prompt-colon {
    expand: false;
    str: "⏻";
    padding: 10px 0px 10px 14px;
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

prompt {
    padding: 10px 10px 10px 0px;
    background-color: inherit;
    text-color: inherit;
    text-align: center;
}

message {
    background-color: transparent;
    text-color: @foreground;
}

listview {
    columns: 1;
    lines: 5;
    scrollbar: false;
    spacing: 5px;
    background-color: transparent;
    border: 0px;
}

element {
    padding: 10px;
    border-radius: 10px;
    background-color: @background-alt;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color: @foreground;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
