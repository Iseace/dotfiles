max-history=100
sort=-time

anchor=top-right
outer-margin=0,10,55,0
font=JetBrainsMono 14
width=400
height=220
border-radius=5
default-timeout=5000

background-color=#0a0a0a
text-color=#f0f0f0
border-color=#333333
progress-color=#333333

[urgency=low]
default-timeout=2000

[urgency=normal]
default-timeout=5000

[urgency=high]
border-color=#ff4d4d
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category

[mode=do-not-disturb]
invisible=1
